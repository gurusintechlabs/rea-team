# Example clean-room image for rea-team. Adapt the "stack" section to your rebuild.
#
# Rules this image must keep (rea-team doctor checks them):
#   - no REA (no `rea` binary, no rea-agents in any npm/npx cache)
#   - Claude Code installed; git installed
#   - nothing from the lab mounted (only clean/ at /work)
#   - after dependencies are installed, the npm registry is NOT reachable
#     (outbound allowlist: the Anthropic API and nothing you don't need)
#
# Build:   docker build -t rea-clean-img -f Dockerfile.example .
# Run:     see USER_GUIDE.md, section 5.

FROM node:22-bookworm

# --- base tools --------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl iptables ipset dnsutils sudo python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# --- Claude Code -------------------------------------------------------------------------
RUN npm install -g @anthropic-ai/claude-code

# --- stack: everything the rebuild and its tests need, installed NOW -------------------------
# Web example: Playwright + browsers, so functional tests run without network later.
RUN npx -y playwright@latest install --with-deps chromium
# Java example (Jira plugins): uncomment
# RUN apt-get update && apt-get install -y openjdk-17-jdk maven && rm -rf /var/lib/apt/lists/*
# Python example: uncomment
# RUN pip3 install --break-system-packages pytest

# Make sure REA can never be present
RUN npm uninstall -g rea-agents 2>/dev/null || true; rm -rf /root/.npm/_npx

# Firewall: copy an allowlist script (e.g. Claude Code's reference devcontainer
# init-firewall.sh) and remove registry.npmjs.org from its allowed domains.
# COPY init-firewall.sh /usr/local/bin/init-firewall.sh
# RUN chmod +x /usr/local/bin/init-firewall.sh

WORKDIR /work
CMD ["sleep", "infinity"]
